generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Starter table for Nakshi Mini (Evaluation preparation)
model Item {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String   @default("Craft")
  price       Float    @default(0.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
